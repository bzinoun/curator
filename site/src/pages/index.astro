---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const base = import.meta.env.BASE_URL;
const langLabel = { fr: 'FR', en: 'EN', ary: 'دارجة' };
---
<Base title="curator — notes de terrain">
  <h1>Articles</h1>
  {articles.length === 0 && <p>Rien de publié pour l'instant — le pipeline chauffe.</p>}
  <ul style="list-style:none; padding:0;">
    {articles.map((a) => (
      <li style="margin-bottom:1.5rem;">
        <a href={`${base}/articles/${a.id}/`} style="font-size:1.15rem; font-weight:600;">
          {a.data.title}
        </a>
        <div style="color:var(--muted); font-size:.85rem;">
          {a.data.date.toISOString().slice(0, 10)} · {langLabel[a.data.lang]}
          {a.data.tags.map((t) => ` · ${t}`).join('')}
        </div>
        <p style="margin:.3rem 0 0;">{a.data.description}</p>
      </li>
    ))}
  </ul>
</Base>
